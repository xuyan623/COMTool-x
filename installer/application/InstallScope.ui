<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>InstallScope</class>
 <widget class="QWidget" name="InstallScope">
  <property name="windowTitle"><string>选择安装位置</string></property>
  <layout class="QVBoxLayout" name="scopeLayout">
   <item><widget class="QLabel" name="Heading"><property name="text"><string>CoRig 把程序、插件和个人工程放在同一个文件夹里，因此安装在当前用户可写的位置。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="Target"><property name="text"><string>默认位置：%LOCALAPPDATA%\Programs\CoRig</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="DataNotice"><property name="text"><string>个人工程、导入的插件与设置都保存在安装文件夹内。升级只替换程序文件，卸载默认保留这些内容。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="MoveNotice"><property name="text"><string>需要放到其他磁盘时，请在下一步选择你有写权限的文件夹。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><spacer name="bottomSpace"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>80</height></size></property></spacer></item>
  </layout>
 </widget>
